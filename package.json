{
  "name": "autosketch",
  "version": "1.0.0",
  "description": "Local MCP server for agent-driven Minecraft schematic building, with visual and palette harnessing",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run test/golden",
    "golden:update": "UPDATE_GOLDEN=1 vitest run test/golden",
    "golden:instance": "tsx scripts/gen-golden-instance.ts",
    "test:local": "vitest run test/local",
    "dev": "tsx src/server/index.ts",
    "start": "node dist/server/index.js"
  },
  "keywords": [
    "minecraft",
    "schematic",
    "mcp",
    "axiom",
    "create"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "autosketch": "dist/server/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "data",
    "library",
    "viewer",
    "README.md",
    "LICENSE"
  ]
}
