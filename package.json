{
  "name": "autosketch",
  "version": "0.1.0",
  "description": "Local MCP server for agent-driven Minecraft schematic building, with visual and palette harnessing",
  "mcpName": "io.github.Builderbot2000/autosketch",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "secrets:scan": "node scripts/secret-scan.mjs --tree",
    "test:watch": "vitest",
    "test:golden": "vitest run test/golden",
    "golden:update": "UPDATE_GOLDEN=1 vitest run test/golden",
    "golden:instance": "tsx scripts/gen-golden-instance.ts",
    "test:local": "vitest run test/local",
    "test:e2e-world": "vitest run test/e2e/world --no-file-parallelism",
    "eval": "tsx test/eval/cli.ts",
    "dev": "tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "package:plugin": "tsx scripts/build-plugin.ts",
    "package:mcpb": "tsx scripts/build-mcpb.ts",
    "package:version": "tsx scripts/sync-versions.ts",
    "prepare": "node -e \"try{require('node:child_process').execSync('git rev-parse --git-dir',{stdio:'ignore'});require('node:child_process').execSync('git config core.hooksPath .githooks')}catch{}\""
  },
  "keywords": [
    "minecraft",
    "schematic",
    "mcp",
    "mcp-server",
    "axiom",
    "create"
  ],
  "author": "Builderbot2000",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Builderbot2000/autosketch.git"
  },
  "homepage": "https://github.com/Builderbot2000/autosketch#readme",
  "bugs": {
    "url": "https://github.com/Builderbot2000/autosketch/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "quickjs-emscripten": "^0.32.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "autosketch": "dist/server/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist/**/*.js",
    "data",
    "library/knowledge",
    "library/palettes",
    "library/prefabs",
    "server.json",
    "README.md",
    "LICENSE"
  ]
}
